# Sample environment for the chart review platform.
# Copy to `.env` (which is git-ignored) and fill in your own values.
# Loaded automatically by config.py via python-dotenv.

# Azure OpenAI credentials (required)
AZURE_OPENAI_API_KEY=your-api-key-here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com

# Deployment name on your Azure OpenAI resource. Used by both the reviewers
# and any code that calls config.create_model() without an explicit override.
AZURE_OPENAI_DEPLOYMENT=gpt-5.2

# Optional. Defaults to 2024-06-01 if unset.
AZURE_OPENAI_API_VERSION=2024-06-01
